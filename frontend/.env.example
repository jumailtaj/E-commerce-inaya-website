# Backend API URL
# During development: http://localhost:5000/api
# During production: https://your-backend-url.com/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (from Google Cloud Console > APIs & Services > Credentials)
# MUST be prefixed with VITE_ so Vite exposes it to the browser bundle
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
